const register = async function ({ registerHook, peertubeHelpers }) {
  const baseRouterUrl = peertubeHelpers.getBaseRouterRoute()

  let formConstraints = {
    maxName: 25,
    maxMessage: 250,
    minAmount: "0.005",
    defaultName: "Anonymous",
    showAmount: false,
    captchaEnabled: false,
    captchaId: ""
  }

  let pollTimer = null

  registerHook({
    target: "action:video-watch.video.loaded",
    handler: (arg) => {
      try {
        const video = arg.video || arg
        removeSuperchatButton()
        if (video.live || video.isLive) {
          addSuperchatButton()
        }
      } catch (e) {
        console.error("[shadowchat] handler error:", e.message)
      }
    }
  })

  function addSuperchatButton() {
    const container = document.querySelector(".d-flex.justify-content-between.flex-direction-column")

    if (!container) {
      setTimeout(addSuperchatButton, 1500)
      return
    }

    const btn = document.createElement("button")
    btn.id = "shadowchat-btn"
    btn.style.cssText = "margin-left:8px;display:inline-flex;align-items:center;gap:4px;width:auto;max-width:fit-content;flex-shrink:0;background:#FF6600;color:#fff;border:none;border-radius:4px;padding:4px 12px;font-size:13px;cursor:pointer;"
    btn.innerHTML = "\u{1F4AC} <span>XMR Superchat</span>"
    btn.addEventListener("click", openModal)

    container.insertBefore(btn, container.children[1] || null)
  }

  function removeSuperchatButton() {
    const btn = document.getElementById("shadowchat-btn")
    if (btn) btn.remove()
  }

  async function openModal() {
    try {
      const html = await fetchProxy("/")
      parseFormConstraints(html)
    } catch (e) {
      console.warn("[shadowchat] using default constraints:", e.message)
    }
    showModalShell()
    renderForm()
  }

  function showModalShell() {
    removeModal()

    const overlay = document.createElement("div")
    overlay.id = "shadowchat-overlay"
    overlay.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:10000;display:flex;align-items:center;justify-content:center;"

    const modal = document.createElement("div")
    modal.id = "shadowchat-modal"
    modal.style.cssText = "background:var(--pt-color-background,#1e1e1e);color:var(--pt-color-foreground,#fff);border-radius:12px;width:90%;max-width:460px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.5);"

    const header = document.createElement("div")
    header.style.cssText = "padding:14px 18px;background:var(--pt-color-primary,#0073e5);color:#fff;display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:15px;"
    header.innerHTML = "<span>\u{1F4AC} XMR Superchat</span><button id=\"sc-close\" style=\"background:none;border:none;color:#fff;font-size:22px;cursor:pointer;line-height:1;\">&times;</button>"

    const body = document.createElement("div")
    body.id = "sc-body"
    body.style.cssText = "padding:18px;overflow-y:auto;flex:1;"

    modal.appendChild(header)
    modal.appendChild(body)
    overlay.appendChild(modal)
    document.body.appendChild(overlay)

    document.getElementById("sc-close").addEventListener("click", closeModal)
    overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal() })
  }

  function renderForm() {
    const body = document.getElementById("sc-body")
    const c = formConstraints

    body.innerHTML = `
      <form id="sc-form" autocomplete="off">
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:13px;margin-bottom:4px;opacity:.8;">Name</label>
          <input type="text" name="name" maxlength="${c.maxName}" placeholder="${c.defaultName}"
            style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #555;background:#2a2a2a;color:#fff;font-size:14px;box-sizing:border-box;">
        </div>
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:13px;margin-bottom:4px;opacity:.8;">Amount (XMR)</label>
          <input type="number" name="amount" min="${c.minAmount}" step="0.0001" value="${c.minAmount}"
            style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #555;background:#2a2a2a;color:#fff;font-size:14px;box-sizing:border-box;">
          <span style="font-size:11px;opacity:.6;">Minimum: ${c.minAmount} XMR</span>
        </div>
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:13px;margin-bottom:4px;opacity:.8;">Message</label>
          <textarea name="message" rows="4" maxlength="${c.maxMessage}"
            style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #555;background:#2a2a2a;color:#fff;font-size:14px;box-sizing:border-box;resize:vertical;"></textarea>
        </div>
        <div style="margin-bottom:16px;">
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;">
            <input type="checkbox" name="showAmount" value="true" ${c.showAmount ? "checked" : ""}>
            Show amount on stream?
          </label>
        </div>
        ${c.captchaEnabled ? `
        <div style="margin-bottom:16px;">
          <label style="display:block;font-size:13px;margin-bottom:4px;opacity:.8;">Captcha</label>
          <img src="${baseRouterUrl}/proxy/captcha/${c.captchaId}.png"
               style="display:block;margin-bottom:6px;border-radius:4px;">
          <input type="text" name="captcha_input" placeholder="Enter captcha"
            style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #555;background:#2a2a2a;color:#fff;font-size:14px;box-sizing:border-box;">
        </div>` : ""}
        <button type="submit"
          style="width:100%;padding:12px;border:none;border-radius:6px;cursor:pointer;background:var(--pt-color-primary,#0073e5);color:#fff;font-size:15px;font-weight:600;">
          Generate Payment
        </button>
      </form>
      <p id="sc-error" style="color:#e74c3c;font-size:13px;margin-top:10px;display:none;"></p>
    `

    document.getElementById("sc-form").addEventListener("submit", onFormSubmit)
  }

  async function onFormSubmit(e) {
    e.preventDefault()
    const form = e.target

    const data = {
      name: form.name.value,
      amount: form.amount.value,
      message: form.message.value
    }
    if (form.showAmount.checked) data.showAmount = "true"

    if (formConstraints.captchaEnabled) {
      data.captcha_id = formConstraints.captchaId
      data.captcha_input = form.captcha_input.value
    }

    const btn = form.querySelector("button[type=\"submit\"]")
    btn.disabled = true
    btn.textContent = "Creating payment\u2026"

    try {
      const res = await fetch(baseRouterUrl + "/proxy/pay", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(data).toString()
      })

      if (!res.ok) throw new Error("Shadowchat returned HTTP " + res.status)

      const html = await res.text()
      parsePayResponse(html)
    } catch (err) {
      const errEl = document.getElementById("sc-error")
      errEl.textContent = err.message
      errEl.style.display = "block"
      btn.disabled = false
      btn.textContent = "Generate Payment"
    }
  }

  function parsePayResponse(html) {
    const doc = new DOMParser().parseFromString(html, "text/html")

    const qrImg = doc.querySelector("img.qr")
    const addrEl = doc.querySelector("#payment_address")
    const address = addrEl ? addrEl.textContent.trim() : ""

    let paymentId = ""
    const checkLink = doc.querySelector("a[href*=\"/check?id=\"]")
    if (checkLink) {
      paymentId = new URL(checkLink.getAttribute("href"), "http://x").searchParams.get("id") || ""
    }
    if (!paymentId) {
      const checkFrame = doc.querySelector("iframe[name=\"checkframe\"]")
      if (checkFrame) {
        paymentId = new URL(checkFrame.getAttribute("src"), "http://x").searchParams.get("id") || ""
      }
    }

    if (!qrImg || !paymentId) {
      const body = document.getElementById("sc-body")
      body.innerHTML =
        "<p style=\"color:#e74c3c;font-size:13px;\">Could not parse payment response.</p>" +
        "<pre style=\"font-size:11px;opacity:.7;overflow:auto;max-height:300px;\">" +
        html.replace(/</g, "&lt;") + "</pre>"
      return
    }

    showPayStep(qrImg.src, address, paymentId)
  }

  function showPayStep(qrSrc, address, paymentId) {
    const body = document.getElementById("sc-body")
    body.innerHTML = `
      <div style="text-align:center;">
        <p style="font-size:14px;opacity:.8;margin-bottom:12px;">Scan with your Monero wallet to pay</p>
        <img src="${qrSrc}" alt="Payment QR" style="width:220px;height:220px;border-radius:8px;margin-bottom:12px;">
        <p style="font-size:11px;word-break:break-all;opacity:.6;margin-bottom:16px;user-select:all;" id="sc-addr">${address}</p>
        <div id="sc-status" style="font-size:14px;opacity:.8;">\u23F3 Waiting for payment\u2026</div>
        <p style="font-size:11px;opacity:.5;margin-top:12px;">Stay on this screen until the transaction is confirmed.</p>
      </div>
    `
    startPolling(paymentId)
  }

  function startPolling(paymentId) {
    stopPolling()
    pollTimer = setInterval(async () => {
      try {
        const res = await fetch(baseRouterUrl + "/proxy/check?id=" + encodeURIComponent(paymentId))
        const html = await res.text()
        const state = parseCheckResponse(html)

        const statusEl = document.getElementById("sc-status")
        if (!statusEl) return stopPolling()

        switch (state) {
          case "paid":
            statusEl.innerHTML = "\u2705 <strong>Payment confirmed! Superchat sent.</strong>"
            statusEl.style.color = "#2ecc71"
            stopPolling()
            break
          case "nsf":
            statusEl.innerHTML = "\u26A0\uFE0F Amount below minimum. Superchat rejected."
            statusEl.style.color = "#f39c12"
            stopPolling()
            break
          case "unknown_id":
            statusEl.innerHTML = "\u274C Unknown payment ID."
            statusEl.style.color = "#e74c3c"
            stopPolling()
            break
          default:
            break
        }
      } catch (e) {}
    }, 3000)
  }

  function stopPolling() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null }
  }

  function parseCheckResponse(html) {
    const doc = new DOMParser().parseFromString(html, "text/html")
    const text = doc.body.textContent
    if (text.includes("Received! Superchat sent.")) return "paid"
    if (text.includes("is below minimum.")) return "nsf"
    if (text.includes("Bad payment ID")) return "unknown_id"
    return "waiting"
  }

  function parseFormConstraints(html) {
    const doc = new DOMParser().parseFromString(html, "text/html")

    const nameInput = doc.querySelector("input[name=\"name\"]")
    const amountInput = doc.querySelector("input[name=\"amount\"]")
    const msgInput = doc.querySelector("textarea[name=\"message\"]")
    const showCb = doc.querySelector("input[name=\"showAmount\"]")
    const captchaHidden = doc.querySelector("input[name=\"captcha_id\"]")

    if (nameInput) {
      formConstraints.maxName = parseInt(nameInput.getAttribute("maxlength") || "25", 10)
      formConstraints.defaultName = nameInput.getAttribute("placeholder") || "Anonymous"
    }
    if (amountInput) {
      formConstraints.minAmount = amountInput.getAttribute("min") || "0.005"
    }
    if (msgInput) {
      formConstraints.maxMessage = parseInt(msgInput.getAttribute("maxlength") || "250", 10)
    }
    if (showCb) {
      formConstraints.showAmount = showCb.hasAttribute("checked")
    }
    if (captchaHidden) {
      formConstraints.captchaEnabled = true
      formConstraints.captchaId = captchaHidden.getAttribute("value") || ""
    }
  }

  async function fetchProxy(path) {
    const res = await fetch(baseRouterUrl + "/proxy" + path)
    if (!res.ok) throw new Error("Proxy returned " + res.status)
    return res.text()
  }

  function closeModal() {
    stopPolling()
    removeModal()
  }

  function removeModal() {
    const overlay = document.getElementById("shadowchat-overlay")
    if (overlay) overlay.remove()
  }
}

export { register }
